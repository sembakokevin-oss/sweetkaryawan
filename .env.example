# ================================================================
# SWEET AI Agent Office (SweetOffice.com) — konfigurasi rahasia
# Salin menjadi .env lalu isi nilainya. JANGAN upload .env ke GitHub.
# ================================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# ID Telegram pemilik (angka, pisahkan koma). Kosong = orang pertama yang /start jadi pemilik.
OWNER_TELEGRAM_IDS=

# --- AI ---
# AI_PROVIDER: claude (utama) | gemini | hermes. Yang lain otomatis jadi cadangan.
AI_PROVIDER=claude
CLAUDE_API_KEY=
# Kosong = otomatis pilih model Sonnet terbaru yang tersedia untuk API key ini
CLAUDE_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Hermes Agent (OpenAI-compatible). Default API server lokal Hermes.
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# SWEET menyalakan "hermes gateway" otomatis saat start (Windows: lewat WSL2)
HERMES_AUTOSTART=true
# Opsional: perintah Hermes khusus, mis. "wsl -e hermes" atau "hermes"
HERMES_CLI=

# --- Lazada Open Platform (https://open.lazada.com) ---
# Kosong = mode simulasi.
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_REDIRECT_URI=http://localhost:8080/lazada/callback
# Sinkron pesanan & chat tiap N menit (0 = mati)
LAZADA_AUTOPILOT_MINUTES=2
# Nilai awal; bisa diubah dari Dashboard › Sistem atau Telegram /set
LAZADA_AUTO_REPLY=false
LAZADA_AUTO_PACK=false
DEMO_ORDERS=true
DEMO_ORDER_SECONDS=90
LAZADA_COOKIES_FILE=cookies.txt
LOW_STOCK_LIMIT=5

# --- Lynk.id ---
# Link halaman/dashboard Lynk.id kamu (tombol "Buka Lynk.id" di dashboard)
LYNK_URL=https://lynk.id
# Opsional: rahasia webhook POST /api/lynk/webhook?secret=...
LYNK_WEBHOOK_SECRET=

# --- Agen otomatis & jam kantor ---
AGENT_AUTOWORK=true
# Jadwal otomatis: 08:00 kerja, 12:00 istirahat, 17:00 laporan harian, malam agen pulang
AUTO_SCHEDULE=true
# Agen mencetak resi baru otomatis (resi masuk dashboard)
AUTO_PRINT_RESI=true
# Keputusan yang tertunda lebih dari N menit-kantor diberi tanda ! (mendesak)
URGENT_MINUTES=60

# --- Server ---
PORT=8080
HOST=127.0.0.1
# Opsional: alamat publik untuk link di Telegram (mis. https://sweetoffice.com)
PUBLIC_URL=

# --- Akun & login ---
# Akun admin awal (kontrol penuh). Kata sandi otomatis dihapus dari file ini setelah tersimpan (ter-hash) di database.
# Isi lagi ADMIN_PASSWORD kapan saja untuk mereset kata sandi admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Kevin

# --- Email OTP (Gmail SMTP) ---
# Pengirim kode OTP pendaftaran & lupa sandi. SMTP_PASS = App Password Gmail 16 huruf
# (aktifkan Verifikasi 2 Langkah, lalu buat di https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SWEET AI Office <emailpengirim@gmail.com>

# --- MetaTrader 5 (HFM) - agent #16 Aurel trading XAUUSD 24 jam ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_NICKNAME=
MT5_ACCOUNT_TYPE=Cent
MT5_PATH=
MT5_SYMBOL=
MT5_BRIDGE_PORT=8765
MT5_BRIDGE_KEY=
MT5_AUTOSTART=true
TRADING_ENABLED=true
TRADING_LOT=0.01
TRADING_MAX_LOT=0.05
TRADING_TF=M15
TRADING_DAILY_LOSS_PCT=5
USD_IDR=16300
TRADING_MIN_BALANCE_USD=5
